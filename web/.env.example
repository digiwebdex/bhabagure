# Copy to .env.local (git-ignored). Placeholders only — this repository is public.

# Where content comes from: "api" (the Laravel API — local and server), or "seed" to work on the design
# without running the API (packages/content-seed).
CONTENT_SOURCE=api
# Seed mode only: also show demo departures, reviews and gallery tiles so those sections can be checked.
CONTENT_DEMO=0
# Laravel API origin, used by the server when CONTENT_SOURCE=api, and for CMS image URLs (API_URL/storage/…).
API_URL=http://localhost:8000
# Optional: where this server reaches the same API for content, when that differs from API_URL (on the VPS a
# loopback-only nginx listener, so content fetches don't leave the box). Blank = API_URL.
API_INTERNAL_URL=
# Same origin, used by the browser for forms and sign-in.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Seed mode only: pretend forms and sign-in succeeded, to check success states without the API.
NEXT_PUBLIC_FORMS_MOCK=0

# Public origins.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PORTAL_URL=http://customer.localhost:3000

# Hosts that serve the customer portal instead of the website (comma-separated, no port).
PORTAL_HOSTS=customer.bhabaghure.com.bd,customer.localhost

# Shared secret the API sends to POST /api/revalidate after a CMS save. Same value as REVALIDATE_SECRET in api/.env.
REVALIDATE_SECRET=
