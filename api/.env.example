# Bhabaghure API — copy to .env (git-ignored) and fill in. Placeholders only: this repository is PUBLIC.
# Generate keys with:  php artisan key:generate  &&  php artisan jwt:secret
# APP_KEY encrypts passport numbers. Losing it makes them unrecoverable — back it up outside the server and git.

APP_NAME=Bhabaghure
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local: the project-local MySQL 8.4 on 3307 (api/README.md) or docker compose. Server: a dedicated
# database and user on the shared MySQL instance — never root.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=bhabaghure
DB_USERNAME=bhabaghure_user
DB_PASSWORD=

# Optional MySQL triggers enforcing the ledger rules at database level. Keep false on the shared host: they need
# the server-wide log_bin_trust_function_creators setting. The application enforces the rules either way.
DB_GUARD_TRIGGERS=false

# Access tokens: 15-minute JWTs. Refresh tokens: 14 days, rotated on use, httpOnly cookie.
JWT_SECRET=
JWT_TTL=15
AUTH_REFRESH_TTL_DAYS=14
# Seconds a just-rotated refresh token still returns its successor to the same browser (reloads, double mounts).
AUTH_REFRESH_REUSE_GRACE_SECONDS=10
# true on the server (HTTPS). Browsers accept Secure cookies on http://localhost too.
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_DOMAIN=

# Origins allowed to call the API with credentials (comma-separated, no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://customer.localhost:3000,http://localhost:5173

# Public website origin, used in links the API sends (e.g. newsletter unsubscribe).
WEB_URL=http://localhost:3000
# Customer portal origin: payments started in the portal return there, and portal invites link to it.
PORTAL_URL=http://customer.localhost:3000

# After a CMS save the API tells the website what to refresh. Same secret as web/.env.local REVALIDATE_SECRET.
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=

# Where the shared seed content lives (default: ../packages/content-seed).
# CONTENT_SEED_PATH=

# Uploaded website images. `public` = storage/app/public, served at APP_URL/storage (php artisan storage:link).
FILESYSTEM_DISK=local
MEDIA_DISK=public

# Local: no Redis needed. Server (shared Redis, docs/deployment.md §5): CACHE_STORE=redis, QUEUE_CONNECTION=redis,
# REDIS_CLIENT=predis (the server has no phpredis extension), REDIS_DB=12 and REDIS_CACHE_DB=13 (reserved for Bhabaghure;
# other sites use 0 and 3), REDIS_QUEUE_RETRY_AFTER=180. bhabaghure-queue.service refuses to start with anything else.
SESSION_DRIVER=array
CACHE_STORE=database
CACHE_PREFIX=bhabaghure_
QUEUE_CONNECTION=sync
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=12
REDIS_CACHE_DB=13
REDIS_PREFIX=bhabaghure_
REDIS_QUEUE_RETRY_AFTER=180

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@bhabaghure.com.bd"
MAIL_FROM_NAME="${APP_NAME}"
# Server (SendGrid SMTP, docs/deployment.md §4): MAIL_MAILER=smtp, MAIL_HOST=smtp.sendgrid.net, MAIL_PORT=587,
# MAIL_SCHEME unset (port 587 upgrades with STARTTLS), MAIL_USERNAME=apikey, MAIL_PASSWORD=<SendGrid API key, Mail Send only>.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Phase 3: booking, payments, passports, invoices (docs/phase-3-booking.md) ──
# SSLCommerz: sandbox | live (live only with APP_ENV=production) | fake (local stand-in, no network; never production).
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_FALLBACK_EMAIL=info@bhabaghure.com.bd
BOOKING_HOLD_MINUTES=45

# Passport OCR: none (type manually) | textract. IAM user limited to textract:DetectDocumentText.
PASSPORT_OCR_PROVIDER=none
AWS_TEXTRACT_REGION=ap-south-1
AWS_TEXTRACT_KEY=
AWS_TEXTRACT_SECRET=

# Invoice PDFs (packages/pdf). A Chrome binary: Chrome for Testing inside the project on the VPS, desktop Chrome locally.
PDF_NODE_BINARY=node
# On the VPS: /var/www/Bhabagure/tools/chrome-for-testing/current/chrome-headless-shell-linux64/chrome-headless-shell
PDF_CHROME_PATH=

# ── Phase 4: WhatsApp and email notifications (docs/phase-4-whatsapp.md, docs/deployment.md §3) ──
# WhatsApp: live (WaSenderAPI) | fake (writes to storage/logs/whatsapp-fake.log; never production) | off (skipped, email continues).
WASENDER_MODE=off
# The session API key of the dedicated notifications number only — never the account's personal access token.
WASENDER_API_KEY=
# Any long random string; the same value goes in the WaSender dashboard's webhook settings.
WASENDER_WEBHOOK_SECRET=
# Account Protection allows one send per 5 seconds; a random 0–3 s is added on top. Daily cap in Dhaka days.
WASENDER_SECONDS_BETWEEN_SENDS=5
WASENDER_JITTER_SECONDS=3
WASENDER_DAILY_CAP=500
# Email copies of every booking, payment and reminder message. Keep on: it is the fallback if WhatsApp stops.
NOTIFICATIONS_EMAIL=true

# SMS through bulksmsbd.net (docs/phase-4-whatsapp.md §10, docs/deployment.md §4a): a fallback for money-critical
# messages WhatsApp couldn't deliver, and the departure-day message. live | fake (storage/logs/sms-fake.log) | off.
BULKSMSBD_MODE=off
# Always HTTPS and POST: the key goes in the form body, never in a URL. There is no automatic fallback to http.
BULKSMSBD_URL=https://bulksmsbd.net/api/smsapi
BULKSMSBD_API_KEY=
# The operator-approved sender ID. Blank = SMS disabled (operators silently drop unapproved sender IDs).
BULKSMSBD_SENDER_ID=
# Blank = each SMS in the booking's language; bn = always Bangla (needed with a masking/brand-name sender ID, which
# bulksmsbd.net only accepts in Bangla).
BULKSMSBD_LOCALE=
# The type sent with Bangla text: text (as their docs show) or unicode, if Bangla arrives garbled on the first real send.
BULKSMSBD_UNICODE_TYPE=text
# BDT per SMS part, for the cost estimates in the admin; confirm against the client's bulksmsbd price list.
BULKSMSBD_COST_PER_PART=0.35
BULKSMSBD_MAX_PARTS=6
# Short invoice links in SMS are APP_URL/i/{code} unless set.
SHORT_LINK_BASE=
