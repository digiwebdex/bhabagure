# /etc/systemd/system/bhabaghure-php.service
#
# PHP-FPM for the Bhabaghure API: its own master, separate from the shared php8.3-fpm (see
# deploy/php-fpm/bhabaghure.conf for why). nginx reaches it at /run/bhabaghure-php/php-fpm.sock.
# Reload (deploy.sh) tests the pool file first; an invalid file leaves the running workers untouched.

[Unit]
Description=Bhabaghure API PHP-FPM (own master, not the shared php8.3-fpm)
Documentation=https://github.com/digiwebdex/bhabagure/blob/main/docs/deployment.md
After=network-online.target mysql.service redis-server.service
Wants=network-online.target
ConditionPathExists=/var/www/Bhabagure/api/public/index.php
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=notify
User=www-data
Group=www-data
RuntimeDirectory=bhabaghure-php
RuntimeDirectoryMode=0750
WorkingDirectory=/var/www/Bhabagure/api
SyslogIdentifier=bhabaghure-php

ExecStartPre=/usr/sbin/php-fpm8.3 --test --fpm-config /var/www/Bhabagure/deploy/php-fpm/bhabaghure.conf -d opcache.memory_consumption=96
ExecStart=/usr/sbin/php-fpm8.3 --nodaemonize --fpm-config /var/www/Bhabagure/deploy/php-fpm/bhabaghure.conf -d opcache.memory_consumption=96
ExecReload=/usr/sbin/php-fpm8.3 --test --fpm-config /var/www/Bhabagure/deploy/php-fpm/bhabaghure.conf -d opcache.memory_consumption=96
ExecReload=/bin/kill -USR2 $MAINPID

Restart=on-failure
RestartSec=10
TimeoutStopSec=40

# Six workers at up to 256 MB each would be 1.5 GB; the cgroup cap stops that long before it reaches the other sites.
MemoryHigh=450M
MemoryMax=600M
MemorySwapMax=0
CPUQuota=100%
TasksMax=64
Nice=5
OOMScoreAdjust=300

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
